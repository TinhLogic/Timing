<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>

    <!-- NuGet Packaging Configuration -->
    <PackageId>Timing.Net</PackageId>
    <Version>1.1.0</Version>
    <Authors>Timing Contributors</Authors>
    <Description>A .NET library for application-wide clock handling with support for UTC/local normalization, TimeProvider integration, and dependency injection</Description>
    <PackageProjectUrl>https://github.com/TinhLogic/Timing</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TinhLogic/Timing</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>clock;timing;datetime;datetimeoffset;timezone;dependency-injection;iclock;timeprovider;net6;net8</PackageTags>
    <PackageReleaseNotes>Add .NET 8 support alongside .NET 6 (multi-targeting) and integrate TimeProvider for .NET 8.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="6.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
