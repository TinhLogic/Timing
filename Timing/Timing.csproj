<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- NuGet Packaging Configuration -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Timing.Net</PackageId>
    <Version>1.0.3</Version>
    <Authors>Timing Contributors</Authors>
    <Description>A .NET library for application-wide clock handling with support for UTC/local normalization and dependency injection</Description>
    <PackageProjectUrl>https://github.com/TinhLogic/Timing</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TinhLogic/Timing</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>clock;timing;datetime;datetimeoffset;timezone;dependency-injection;iclock</PackageTags>
    <PackageReleaseNotes>Initial release with IClock abstraction for DateTimeKind consistency</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="6.0.0" />
  </ItemGroup>
</Project>